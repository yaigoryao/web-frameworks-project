@Table({ tableName: 'data' })
export class DataModel extends Model<DataModel> {
  @Column({ type: DataType.INTEGER, primaryKey: true, autoIncrement: true })
  id: number;

  @Column({ type: DataType.STRING })
  value: string;
}
