# DATABASE
# Для локальной разработки используйте SQLite
# Для production используйте PostgreSQL
DB_DIALECT=sqlite
DB_STORAGE=./dev.db
DB_HOST=localhost
DB_PORT=5432
DB_NAME=app_db
DB_USERNAME=postgres
DB_PASSWORD=postgres

# SERVICES
USER_SERVICE_PORT=3001
DATA_SERVICE_PORT=3002

